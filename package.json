{
  "name": "unvia",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run build:css && node --watch server.js",
    "start": "node server.js",
    "desktop": "electron .",
    "desktop:build": "electron-builder",
    "cap:add": "cap add android && cap add ios",
    "android": "npm run build:css && cap sync android && cap open android",
    "ios": "npm run build:css && cap sync ios && cap open ios",
    "test": "node tests/run.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --watch",
    "vapid": "node -e \"console.log(require('web-push').generateVAPIDKeys())\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "~3.4.17"
  },
  "build": {
    "appId": "com.realunfazed.unvia",
    "productName": "Unvia",
    "files": [
      "electron/**"
    ]
  },
  "description": "Unvia: a full-stack social platform (Node.js, MongoDB, Tailwind) for web, Android, iOS and desktop.",
  "author": "Alireza Asakareh (RealUnfazed)",
  "license": "MIT",
  "optionalDependencies": {
    "web-push": "^3.6.7"
  }
}
